# Endereço e porta expostos no servidor.
HERMES_BIND_ADDRESS=0.0.0.0
HERMES_PORT=8000

# Limite por arquivo em bytes. O padrão abaixo equivale a 100 MiB.
FLET_MAX_UPLOAD_SIZE=104857600

# Tempo de uma sessão web inativa, em segundos.
FLET_SESSION_TIMEOUT=3600

# Proteções contra sobrecarga. Ajuste somente após teste de carga.
HERMES_MAX_CONCURRENT_JOBS=2
HERMES_MAX_FILES_PER_JOB=20
HERMES_MAX_TOTAL_UPLOAD_SIZE=209715200
HERMES_MEMORY_LIMIT=2g
HERMES_CPU_LIMIT=2.0
HERMES_LOG_LEVEL=INFO

# Telemetria opcional. Crie um Write Token no projeto Carmel do Logfire.
# Nunca versione ou compartilhe o valor de LOGFIRE_TOKEN.
HERMES_TELEMETRY_ENABLED=true
HERMES_LOGFIRE_SYSTEM_METRICS=true
LOGFIRE_ENVIRONMENT=production
LOGFIRE_TOKEN=
